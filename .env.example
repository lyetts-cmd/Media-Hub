# Copy this file to .env and fill in your values before running docker compose.

# Port the application listens on (host port exposed by Docker Compose)
PORT=4000

# PostgreSQL password for the 'cadence' database user.
# Must match in both the db and app services.
POSTGRES_PASSWORD=changeme

# Full database connection URL used by the app container.
# The hostname 'db' matches the service name in docker-compose.yml.
# Update the password to match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://cadence:changeme@db:5432/cadence_music

# Absolute path to your media library on the host machine.
# This folder is bind-mounted into the container at /cascadeMedia.
MUSIC_DIR=/home/pi/Music

# Pre-built image tag (only used if you switch docker-compose.yml to Option A).
CADENCE_IMAGE=ghcr.io/lyetts-cmd/media-hub:latest

# --- Transcoding performance tuning ---
# Number of simultaneous FFmpeg transcoding jobs (1 is safe for Pi 4).
TRANSCODE_WORKERS=1

# FFmpeg thread count per job (0 = let FFmpeg decide, recommended).
FFMPEG_THREADS=0

# Hardware acceleration: leave empty for software (safe default).
# Set to "vaapi" on Intel/AMD x86 machines with integrated graphics.
FFMPEG_HWACCEL=

# VAAPI device path (only used when FFMPEG_HWACCEL=vaapi).
VAAPI_DEVICE=/dev/dri/renderD128
