DATABASE_URL=postgres://cadence:yourpassword@localhost:5432/cadence_music

PORT=4000

NODE_ENV=production

# Optional: override the path to the built web client if you move files around.
# Defaults to artifacts/web-client/dist/public relative to the API server bundle.
# WEB_CLIENT_DIST=/opt/cadence-music/artifacts/web-client/dist/public

# ---------------------------------------------------------------------------
# Transcoding performance tuning
# ---------------------------------------------------------------------------
# Recommended values by hardware:
#
#   Hardware         | TRANSCODE_WORKERS | FFMPEG_THREADS | FFMPEG_HWACCEL
#   -----------------|-------------------|----------------|---------------
#   Raspberry Pi 4   |        1          |       2        | (leave unset)
#   Low-spec x86     |        2          |       4        | (leave unset)
#   Mid/high-spec x86|        4          |       0        | vaapi (if supported)
#
# How many simultaneous ffmpeg transcoding jobs are allowed.
# Default: 1 (safe for Raspberry Pi and single-core systems).
# Increase to 2–4 on multi-core x86 machines.
# TRANSCODE_WORKERS=1

# Number of CPU threads ffmpeg may use per transcoding job.
# Default: 0 (auto — ffmpeg chooses based on available cores).
# Set explicitly if you want to cap CPU usage per job.
# FFMPEG_THREADS=0

# Optional hardware acceleration backend.
# Currently supported: vaapi (Intel/AMD integrated graphics on Linux x86).
# Leave unset for software encoding (default, works everywhere).
# FFMPEG_HWACCEL=vaapi

# Path to the VAAPI render device. Only used when FFMPEG_HWACCEL=vaapi.
# Default: /dev/dri/renderD128 (correct for most Intel/AMD integrated GPUs).
# VAAPI_DEVICE=/dev/dri/renderD128
